{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed with wrangler until cf builds Astro 6+ (unsupported during the cf beta).
  "name": "chinstrap-website",
  "account_id": "0aeb879de8e3cdde5fb3d413025222ce",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  // Cloudflare creates the DNS record and certificate on first deploy;
  // the korora.tech zone is in the same account.
  "routes": [{ "pattern": "chinstrap.korora.tech", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
